diff --git a/src/citra_libretro/CMakeLists.txt b/src/citra_libretro/CMakeLists.txt
index e28f9941b..b2aed11eb 100644
--- a/src/citra_libretro/CMakeLists.txt
+++ b/src/citra_libretro/CMakeLists.txt
@@ -99,3 +99,29 @@ else()
 endif()
 
 add_custom_target(azahar_libretro DEPENDS citra_libretro)
+
+# 3DS-web: browser build. Links the libretro core with a minimal web frontend
+# into a runnable .js/.wasm pair instead of a shared library.
+if(EMSCRIPTEN)
+  target_compile_definitions(citra_libretro_common PRIVATE USING_GLES)
+  target_compile_definitions(citra_libretro PRIVATE USING_GLES)
+
+  if(WEB_FRONTEND_DIR)
+    add_executable(azahar_web
+            ${WEB_FRONTEND_DIR}/main.cpp
+            citra_libretro.cpp
+            citra_libretro.h
+            $<TARGET_OBJECTS:citra_libretro_common>)
+    target_compile_definitions(azahar_web PRIVATE HAVE_LIBRETRO USING_GLES)
+    target_link_libraries(azahar_web PRIVATE citra_common citra_core video_core
+            Boost::boost dds-ktx libretro tsl::robin_map glad Threads::Threads)
+    target_link_options(azahar_web PRIVATE
+            -sMIN_WEBGL_VERSION=2 -sMAX_WEBGL_VERSION=2 -sFULL_ES3
+            -sGL_ENABLE_GET_PROC_ADDRESS
+            -sALLOW_MEMORY_GROWTH -sINITIAL_MEMORY=536870912 -sMAXIMUM_MEMORY=2147483648
+            -sPTHREAD_POOL_SIZE=8 -sSTACK_SIZE=5242880
+            -sFORCE_FILESYSTEM
+            -sEXPORTED_FUNCTIONS=_main,_web_load_game
+            -sEXPORTED_RUNTIME_METHODS=FS,ccall,cwrap)
+  endif()
+endif()
