+bool NCCHContainer::IsMisflaggedPlaintext() {
+#ifdef __EMSCRIPTEN__
+    // No decryption happens here: this only recognises contents that are already plaintext.
+    if (!file || !file->IsOpen()) {
+        return false;
+    }
+    bool plaintext = false;
+    if (ncch_header.extended_header_size) {
+        // A decrypted extended header repeats the program ID as the jump ID
+        ExHeader_Header exheader{};
+        plaintext = file->ReadAtBytes(&exheader, sizeof(exheader), sizeof(NCCH_Header)) ==
+                        sizeof(exheader) &&
+                    exheader.system_info.jump_id == exheader.arm11_system_local_caps.program_id;
+    } else if (ncch_header.exefs_size) {
+        // No extended header (DLC, system archives): look for a readable ExeFS file name
+        ExeFs_Header exefs{};
+        const std::size_t offset = static_cast<std::size_t>(ncch_header.exefs_offset) * kBlockSize;
+        if (file->ReadAtBytes(&exefs, sizeof(exefs), offset) == sizeof(exefs)) {
+            const std::string_view name{exefs.section[0].name,
+                                        strnlen(exefs.section[0].name, 8)};
+            plaintext = name == ".code" || name == "icon" || name == "banner" || name == "logo";
+        }
+    }
+    if (plaintext) {
+        LOG_WARNING(Service_FS, "NCCH is marked as encrypted but its contents are decrypted. "
+                                "Loading it without crypto.");
+    }
+    return plaintext;
+#else
+    return false;
+#endif
+}
