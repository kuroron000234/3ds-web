new file mode 100644
index 000000000..43aa1896a
--- /dev/null
+++ b/src/common/web_prof.h
@@ -0,0 +1,35 @@
+// Copyright 2026 Citra Emulator Project / Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the misc/licenses/gplv2.txt file included.
+
+#pragma once
+
+// Coarse time accounting for the web build: how much of the emulation thread's time goes to
+// GPU command processing, presenting and audio. Everything else in a frame is the CPU core.
+// All scopes run on the emulation thread and never nest within the same slot.
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+
+extern "C" double web_prof_ms[4];
+
+namespace Common {
+enum class WebProfSlot { Gpu = 0, Present = 1, Audio = 2 };
+
+class WebProfScope {
+public:
+    explicit WebProfScope(WebProfSlot slot_) : slot{slot_}, start{emscripten_get_now()} {}
+    ~WebProfScope() {
+        web_prof_ms[static_cast<int>(slot)] += emscripten_get_now() - start;
+    }
+
+private:
+    WebProfSlot slot;
+    double start;
+};
+} // namespace Common
+
+#define WEB_PROF_SCOPE(slot) const Common::WebProfScope web_prof_scope{Common::WebProfSlot::slot}
+#else
+#define WEB_PROF_SCOPE(slot)
+#endif
