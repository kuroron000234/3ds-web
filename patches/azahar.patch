+// The bundled open source replacement for the standard shared font has empty glyph cells for
+// 20 characters (U+3093, U+30F6, "~", U+FF5E, a dozen kanji and a few accented letters) and
+// leaves them out of its character map, so games draw the fallback "?" in their place. Draw
+// those glyphs into the empty cells and add them to the (final, scan-type) CMAP section.
+// A font that already maps these characters or uses the cells (such as one dumped from a
+// console) is left untouched. Returns the new size of the font.
+static u32 RepairOpenSourceFont(u8* font, u32 size, u32 capacity) {
+    const auto rd16 = [&](u32 o) { return static_cast<u16>(font[o] | font[o + 1] << 8); };
+    const auto rd32 = [&](u32 o) { return static_cast<u32>(rd16(o) | rd16(o + 2) << 16); };
+    const auto wr16 = [&](u32 o, u16 v) {
+        font[o] = static_cast<u8>(v);
+        font[o + 1] = static_cast<u8>(v >> 8);
+    };
+    const auto wr32 = [&](u32 o, u32 v) {
+        wr16(o, static_cast<u16>(v));
+        wr16(o + 2, static_cast<u16>(v >> 16));
+    };
+
+    constexpr u32 finf = 0x14;
+    if (size < 0x40 || std::memcmp(font + finf, "FINF", 4) != 0) {
+        return size;
+    }
+
+    // Glyph sheets: 128x32 A4 textures holding five 24x30 cells each, with a 1 pixel border
+    const u32 tglp = rd32(finf + 0x10); // points past the section header
+    if (tglp < 8 || tglp + 0x18 > size || std::memcmp(font + tglp - 8, "TGLP", 4) != 0) {
+        return size;
+    }
+    constexpr u32 cell_w = 24, cell_h = 30, per_sheet = 5, sheet_w = 128, sheet_h = 32;
+    const u32 sheet_size = rd32(tglp + 4);
+    const u32 sheet_count = rd16(tglp + 8);
+    const u32 sheets = rd32(tglp + 0x14);
+    if (font[tglp] != cell_w || font[tglp + 1] != cell_h || rd16(tglp + 0xA) != 0xB ||
+        rd16(tglp + 0xC) != per_sheet || rd16(tglp + 0xE) != 1 || rd16(tglp + 0x10) != sheet_w ||
+        rd16(tglp + 0x12) != sheet_h || sheet_size != sheet_w * sheet_h / 2 ||
+        sheets + sheet_count * sheet_size > size) {
+        return size;
+    }
+    // Position of a pixel in a sheet: 8x8 tiles in Z-order, two pixels per byte (low nibble first)
+    const auto pixel = [&](u32 index, u32 x, u32 y) -> std::pair<u32, u32> {
+        x += (index % per_sheet) * (cell_w + 1) + 1;
+        y += 1;
+        u32 morton = 0;
+        for (u32 bit = 0; bit < 3; ++bit) {
+            morton |= ((x >> bit) & 1) << (2 * bit) | ((y >> bit) & 1) << (2 * bit + 1);
+        }
+        const u32 n = ((y / 8) * (sheet_w / 8) + x / 8) * 64 + morton;
+        return {sheets + (index / per_sheet) * sheet_size + n / 2, (n & 1) * 4};
+    };
+    const auto cell_is_empty = [&](u32 index) {
+        if (index >= sheet_count * per_sheet) {
+            return false;
+        }
+        for (u32 y = 0; y < cell_h; ++y) {
+            for (u32 x = 0; x < cell_w; ++x) {
+                const auto [offset, shift] = pixel(index, x, y);
+                if ((font[offset] >> shift) & 0xF) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    };
+
+    const u32 map_data = rd32(finf + 0x18); // points past the section header
+    if (map_data < 8 || map_data + 0x10 > size) {
+        return size;
+    }
+    const u32 cmap = map_data - 8;
+    const u32 section_size = rd32(cmap + 4);
+    const u32 pairs = cmap + 0x16;
+    const u32 count = rd16(cmap + 0x14);
+    // Only a single scan-type map that ends the file can be extended in place
+    if (std::memcmp(font + cmap, "CMAP", 4) != 0 || rd16(cmap + 0xC) != 2 ||
+        rd32(cmap + 0x10) != 0 || cmap + section_size != size ||
+        pairs + count * 4 != size) {
+        return size;
+    }
+
+    std::map<u16, u16> map; // code -> glyph index
+    std::set<u16> used;
+    for (u32 i = 0; i < count; ++i) {
+        const u16 index = rd16(pairs + i * 4 + 2);
+        map[rd16(pairs + i * 4)] = index;
+        used.insert(index);
+    }
+    u32 added = 0;
+    for (const auto& glyph : SHARED_FONT_PATCH_GLYPHS) {
+        if (map.contains(glyph.code) || used.contains(glyph.index) ||
+            !cell_is_empty(glyph.index) || size + (added + 1) * 4 > capacity) {
+            continue;
+        }
+        for (u32 y = 0; y < cell_h; ++y) {
+            for (u32 x = 0; x < cell_w; ++x) {
+                const u32 n = y * cell_w + x;
+                const u8 alpha = (glyph.alpha[n / 2] >> ((n & 1) * 4)) & 0xF;
+                const auto [offset, shift] = pixel(glyph.index, x, y);
+                font[offset] = static_cast<u8>((font[offset] & ~(0xF << shift)) | alpha << shift);
+            }
+        }
+        map[glyph.code] = glyph.index;
+        ++added;
+    }
+    if (added == 0 || map.size() > 0xFFFF) {
+        return size;
+    }
+
+    wr16(cmap + 0x14, static_cast<u16>(map.size()));
+    u32 o = pairs;
+    for (const auto& [code, index] : map) {
+        wr16(o, code);
+        wr16(o + 2, index);
+        o += 4;
+    }
+    wr32(cmap + 4, section_size + added * 4);
+    wr32(0xC, o); // file size in the CFNT header
+    LOG_INFO(Service_APT, "Added {} missing characters to the shared font", added);
+    return o;
+}
